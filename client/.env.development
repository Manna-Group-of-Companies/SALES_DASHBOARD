# Development settings, committed on purpose.
#
# Vite loads this automatically for `npm run dev`, so a fresh clone runs
# against the live ERPNext site with no setup step. Nothing here is secret:
# the site URL is public, and the dashboard authenticates with the user's own
# ERPNext login rather than any key.
#
# Without a file like this, `VITE_ERP_URL` is undefined, the dev proxy falls
# back to http://localhost:8000, and every request fails against a server that
# is not running — with nothing on screen explaining why. That is worth
# removing as a way for a new developer to lose an afternoon.
#
# `.env.local` still overrides this and stays out of git, so anyone pointing at
# a different site can do so without touching the repo.

# Real data, not the in-memory fixtures. The flag defaults to `true` in
# src/api/config.ts, so this line is what connects the app to ERPNext.
VITE_USE_MOCK=false

# Proxied by vite.config.ts so the browser sees same-origin requests and
# Frappe's SameSite=Lax session cookie is actually sent.
VITE_ERP_URL=https://mannarubber.m.frappe.cloud

# How often the shared stock ledger is re-read, in milliseconds.
VITE_MIN_STOCK_POLL_MS=10000
