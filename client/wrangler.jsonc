{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sales-dashboard",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],

  // Committed on purpose. Without a config file here, `wrangler deploy` runs
  // its interactive first-time setup, guesses a Vite project, and writes an
  // assets-only config with no `main` — which deploys the bundle without the
  // reverse proxy. See `worker/index.js`.
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",

    // Deep links (/orders/SAL-ORD-2026-00106) and refreshes have to reach the
    // router rather than 404. This replaces `public/_redirects`; the old
    // `/* /index.html 200` rule is rejected outright by Workers, which already
    // strips `.html` and `/index` and so reads the rule as an infinite loop.
    "not_found_handling": "single-page-application",

    // Without this, single-page-application handling answers *every* unmatched
    // path with index.html — including /api/*, which would hand ERPNext calls
    // a page of HTML instead of proxying them.
    "run_worker_first": ["/api/*", "/private/*", "/files/*"]
  },

  "vars": {
    // Read by the proxy at runtime. Declared here rather than left to the
    // dashboard because the fallback in `_proxy.js` is the live site: an unset
    // variable does not fail, it silently keeps working against production
    // while looking like it is pointed somewhere else. Not a secret — the URL
    // is public and every user authenticates with their own ERPNext login.
    "ERP_URL": "https://mannarubber.m.frappe.cloud"
  },

  "observability": {
    "enabled": true
  }
}
