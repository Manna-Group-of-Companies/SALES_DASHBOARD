{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sales-dashboard",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-11",

  // `dist` is Vite's output. The binding is what `worker/index.js` calls to
  // serve a file; `single-page-application` is what makes React Router deep
  // links work, and replaces the old `public/_redirects`.
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",

    // Without this the asset store answers first, and because
    // `single-page-application` resolves *every* unmatched path to index.html,
    // /api/method/login would return the HTML shell instead of reaching
    // ERPNext. Listing the proxied prefixes runs the Worker first for those and
    // only those — static assets still bypass it entirely.
    "run_worker_first": [
      "/api",
      "/api/*",
      "/private",
      "/private/*",
      "/files",
      "/files/*"
    ]
  },

  // Mirrors what is already set on the Worker in the Cloudflare dashboard, so a
  // deploy stops reporting config drift and stops silently flipping these on.
  // The site is reached through its custom domain; the workers.dev and preview
  // URLs stay closed.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  }

  // ERP_URL is NOT set here. It is a dashboard environment variable, read at
  // runtime by proxy(), so pointing at a staging site needs no rebuild.
}
