# Copy to `.env.local` and edit.

# true  -> the app runs entirely on in-memory fixtures (no ERPNext needed)
# false -> every request goes to the ERPNext site below
#
# Set this to false to work against the live Manna Rubber site — the SAME
# database the field-sales Flutter app uses. Customers, Items, Sales Persons and
# Sales Orders are then the real ones. See docs/ERPNEXT_DOCTYPES.md for the
# custom fields this module still needs created there.
VITE_USE_MOCK=false

# The shared ERPNext site (same as MANNA_FIELD_SALES/lib/core/session.dart).
VITE_ERP_URL=https://mannarubber.m.frappe.cloud

# How often (ms) the minimum-stock ledger is re-polled so reps see each
# other's bookings.
VITE_MIN_STOCK_POLL_MS=10000
