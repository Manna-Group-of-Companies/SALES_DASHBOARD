# Production build settings.
#
# VITE_USE_MOCK defaults to TRUE in code, so this file is not optional: without
# it a production build ships the fixture data and nobody notices until someone
# approves an order that does not exist.
VITE_USE_MOCK=false

# Deliberately empty.
#
# In development Vite proxies to VITE_ERP_URL. In production the browser calls
# this host's own /api, which Pages Functions forward to ERPNext — so the app
# needs no ERPNext URL at all, and the upstream address lives in the Cloudflare
# environment variable ERP_URL where it can be changed without a rebuild.
VITE_ERP_URL=

# How often the shared stock ledger is re-read, in milliseconds.
VITE_MIN_STOCK_POLL_MS=60000
