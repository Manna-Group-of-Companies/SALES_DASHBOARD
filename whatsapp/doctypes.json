{
  "about": "The two doctypes behind the WhatsApp messages (README section 3). Event options gained Payment Received on 10 Nov 2026.",
  "doctypes": [
    {
      "doctype": "DocType",
      "name": "Manna WhatsApp Settings",
      "module": "Selling",
      "custom": 1,
      "issingle": 1,
      "fields": [
        {
          "fieldname": "enabled",
          "fieldtype": "Check",
          "label": "Enabled"
        },
        {
          "fieldname": "test_mode",
          "fieldtype": "Check",
          "label": "Test Mode",
          "default": "1"
        },
        {
          "fieldname": "test_numbers",
          "fieldtype": "Small Text",
          "label": "Test Numbers",
          "description": "One number per line. Only these get messages while test mode is on."
        },
        {
          "fieldname": "phone_number_id",
          "fieldtype": "Data",
          "label": "Phone Number ID"
        },
        {
          "fieldname": "waba_id",
          "fieldtype": "Data",
          "label": "WhatsApp Business Account ID"
        },
        {
          "fieldname": "access_token",
          "fieldtype": "Password",
          "label": "Access Token"
        },
        {
          "fieldname": "api_version",
          "fieldtype": "Data",
          "label": "API Version",
          "default": "v21.0"
        },
        {
          "fieldname": "language_code",
          "fieldtype": "Data",
          "label": "Language Code",
          "default": "en"
        }
      ],
      "permissions": [
        {
          "role": "System Manager",
          "read": 1,
          "write": 1,
          "create": 1
        }
      ]
    },
    {
      "doctype": "DocType",
      "name": "Manna WhatsApp Message",
      "module": "Selling",
      "custom": 1,
      "autoname": "hash",
      "track_changes": 0,
      "sort_field": "creation",
      "sort_order": "DESC",
      "fields": [
        {
          "fieldname": "dedupe_key",
          "fieldtype": "Data",
          "label": "Dedupe Key",
          "unique": 1,
          "read_only": 1
        },
        {
          "fieldname": "sales_order",
          "fieldtype": "Link",
          "label": "Sales Order",
          "options": "Sales Order",
          "in_list_view": 1,
          "in_standard_filter": 1
        },
        {
          "fieldname": "customer",
          "fieldtype": "Link",
          "label": "Customer",
          "options": "Customer",
          "in_list_view": 1
        },
        {
          "fieldname": "event",
          "fieldtype": "Select",
          "label": "Event",
          "options": "Order Approved\nDelivery Created\nPayment Received",
          "in_list_view": 1,
          "in_standard_filter": 1
        },
        {
          "fieldname": "delivery_note",
          "fieldtype": "Data",
          "label": "Delivery Note"
        },
        {
          "fieldname": "phone",
          "fieldtype": "Data",
          "label": "Phone"
        },
        {
          "fieldname": "template",
          "fieldtype": "Data",
          "label": "Template"
        },
        {
          "fieldname": "params",
          "fieldtype": "Code",
          "label": "Params",
          "options": "JSON"
        },
        {
          "fieldname": "status",
          "fieldtype": "Select",
          "label": "Status",
          "options": "Queued\nSending\nSent\nFailed\nSkipped",
          "default": "Queued",
          "in_list_view": 1,
          "in_standard_filter": 1
        },
        {
          "fieldname": "attempts",
          "fieldtype": "Int",
          "label": "Attempts"
        },
        {
          "fieldname": "wa_message_id",
          "fieldtype": "Data",
          "label": "WhatsApp Message ID"
        },
        {
          "fieldname": "sent_at",
          "fieldtype": "Datetime",
          "label": "Sent At"
        },
        {
          "fieldname": "error",
          "fieldtype": "Small Text",
          "label": "Error"
        }
      ],
      "permissions": [
        {
          "role": "System Manager",
          "read": 1,
          "write": 1,
          "create": 1,
          "delete": 1
        },
        {
          "role": "Sales Manager",
          "read": 1
        }
      ]
    }
  ]
}